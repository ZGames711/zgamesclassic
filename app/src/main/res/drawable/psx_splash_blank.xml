<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally empty icon: the system splash shows only the background
     colour; the animated logo splash is drawn in Compose right after it,
     so there is never a double logo or a cropped round icon on Android 12+. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/psx_transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
