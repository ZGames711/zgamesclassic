<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Psx" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/psx_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch theme for MainActivity (androidx core-splashscreen, works on
         every API level). The system splash is just the background colour;
         installSplashScreen() then switches to postSplashScreenTheme. -->
    <style name="Theme.Psx.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/psx_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/psx_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Psx</item>
    </style>
</resources>
